<launch>
  <!-- Kinematic Controller Node -->
  <node pkg="kinematic_controller" exec="kinematic_controller_node" name="kinematic_controller" output="screen">
    <param name="urdf_file_name" value="$(find-pkg-share kortex_description)/robots/gen3.urdf"/>
    <param name="use_sim_time" value="true"/>
    <param name="publish_rate" value="500.0"/>
  </node>
</launch>